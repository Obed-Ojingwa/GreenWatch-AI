# ---- GreenWatch backend configuration. Copy to .env (never commit .env). ----
ENVIRONMENT=development            # "production" turns on fail-fast config checks

# Database. Local dev defaults to SQLite. For Supabase paste the Postgres connection string
# (postgres:// and postgresql:// are accepted); apply app/db/schema.sql once in the SQL editor.
DATABASE_URL=sqlite:///./greenwatch_dev.db
AUTO_CREATE_TABLES=false

# Object storage: "local" (dev) or "supabase" (production; private bucket, service key stays here).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=greenwatch

# Demo mode: write/analysis endpoints require header X-Demo-Key = this value (>= 16 chars in production).
DEMO_ACCESS_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173   # comma-separated allowed origins

# ---- Meta Model API. Published request contracts; verify account access with Gate 0. ----
# Set META_API_KEY in this ignored file locally or in the hosting dashboard for production.
# Never commit it, paste it into chat, or expose it through VITE_*.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_AUTH_HEADER=Authorization
META_AUTH_SCHEME=Bearer
AGENT_MODEL=muse-spark-1.3
VISION_QC_MODEL=                 # defaults to AGENT_MODEL when empty
META_CHAT_PATH=chat/completions
SAM_MODEL=sam-3.1
META_SEGMENT_PATH=responses
META_SAM_MASK_ENCODING=one_bit
# Legacy JSON endpoint settings (not used when META_SEGMENT_PATH=responses).
META_SEGMENT_BODY='{"model": "{{model}}", "image": "{{image_b64}}", "prompt": "{{prompt}}"}'
META_SEGMENT_MASKS_PATH=

# ---- Limits ----
MAX_UPLOAD_MB=15
MAX_IMAGE_DIM=2048
MAX_AGENT_RUNS_PER_HOUR=20
MAX_TOOL_CALLS_PER_RUN=40
MAX_QC_RETRIES=1
