# ---- GreenWatch backend configuration. Copy to .env (never commit .env). ----
ENVIRONMENT=development

# Database. Local development may use SQLite; production requires Supabase Postgres.
DATABASE_URL=sqlite:///./greenwatch_dev.db
AUTO_CREATE_TABLES=false

# Object storage: local for development or private Supabase Storage for production.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=greenwatch

# Demo mode: write/analysis endpoints require X-Demo-Key (>= 16 random characters in production).
DEMO_ACCESS_KEY=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

# Gemini is primary for agent orchestration and vision QC.
# Create the key in Google AI Studio (https://aistudio.google.com/apikey).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AGENT_MODEL=
VISION_QC_MODEL=

# Meta SAM segmentation is a separate provider. Keep all keys server-side.
META_API_KEY=
META_DIAGNOSTIC_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_AUTH_HEADER=Authorization
META_AUTH_SCHEME=Bearer
SAM_MODEL=sam-3.1
META_SEGMENT_PATH=responses
META_SAM_MASK_ENCODING=one_bit
# Used for Meta chat only when AI_PROVIDER=meta.
META_CHAT_PATH=chat/completions
# Only for the legacy SAM JSON adapter; ignored when META_SEGMENT_PATH=responses.
META_SEGMENT_BODY='{"model": "{{model}}", "image": "{{image_b64}}", "prompt": "{{prompt}}"}'
META_SEGMENT_MASKS_PATH=

# Limits
MAX_UPLOAD_MB=15
MAX_IMAGE_DIM=2048
MAX_AGENT_RUNS_PER_HOUR=20
MAX_TOOL_CALLS_PER_RUN=40
MAX_QC_RETRIES=1
